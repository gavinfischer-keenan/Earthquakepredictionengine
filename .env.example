# =============================================================================
# EarthquakePredictionEngine — Configuration
# Copy this file to .env and edit to match your Raspberry Shake setup.
# =============================================================================

# ---------------------------------------------------------------------------
# Raspberry Shake RS4D Connection
# ---------------------------------------------------------------------------
# Hostname or IP of your Raspberry Shake device
SHAKE_IP=192.168.4.164
# Station code (printed on your Shake, e.g. R1A3D)
SHAKE_STATION=R1A3D
# FDSN network code (AM = Raspberry Shake citizen network)
SHAKE_NETWORK=AM
# Primary channel to monitor (EHZ=vertical geophone)
SHAKE_CHANNEL=EHZ
# All RS4D channels (comma-separated or JSON list)
SHAKE_CHANNELS=EHZ,ENZ,ENN,ENE

# ---------------------------------------------------------------------------
# Station Location & Timezone (used for distance, radar, and quiet-window math)
# ---------------------------------------------------------------------------
STATION_LAT=37.8696
STATION_LON=-122.2491
STATION_ELEVATION=161.1
STATION_TZ=America/Los_Angeles
STATION_NAME=Berkeley Hills
# Public showcase mode hides simulation controls, Earth Audio, and ML Dataset studio
PUBLIC_MODE=false

# ---------------------------------------------------------------------------
# Data Ingestion
# ---------------------------------------------------------------------------
# Ingest mode: "seedlink" (preferred, TCP) or "udp" (raw packets)
INGEST_MODE=seedlink
# UDP port for raw Shake data (only used when INGEST_MODE=udp)
UDP_PORT=8888
# SeedLink server port on the Shake
SEEDLINK_PORT=18000

# ---------------------------------------------------------------------------
# STA/LTA Trigger Parameters
# ---------------------------------------------------------------------------
# Short-Term Average window in seconds
STA_SECONDS=0.5
# Long-Term Average window in seconds
LTA_SECONDS=20.0
# STA/LTA ratio to trigger ON (declare potential event)
TRIGGER_ON=6.5
# STA/LTA ratio to trigger OFF (end of event)
TRIGGER_OFF=2.0

# ---------------------------------------------------------------------------
# Bandpass Filter
# ---------------------------------------------------------------------------
# Lower corner frequency (Hz) for Butterworth bandpass
BANDPASS_LOW=1.0
# Upper corner frequency (Hz) for Butterworth bandpass
BANDPASS_HIGH=10.0

# ---------------------------------------------------------------------------
# Event Validation
# ---------------------------------------------------------------------------
# Minimum trigger duration to accept an event (rejects spikes)
MIN_TRIGGER_DURATION_SEC=1.2
# Predominant-period (Pd) measurement window after P-arrival (seconds)
PD_WINDOW_SEC=3.0
# Tau-c (period parameter) measurement window after P-arrival (seconds)
TC_WINDOW_SEC=3.0

# ---------------------------------------------------------------------------
# Machine Learning (optional — requires [ml] extras)
# ---------------------------------------------------------------------------
# Enable ML-based phase picking (requires [onnx] or [ml] extras)
ML_ENABLED=false
# ML backend selection: "auto", "onnx", "seisbench", or "heuristic"
ML_BACKEND=auto
# Path to optional lightweight PhaseNet ONNX weights file
ML_ONNX_MODEL_PATH=./data/models/phasenet.onnx
# P-wave detection probability threshold (0.0–1.0)
ML_P_THRESHOLD=0.3
# SeisBench model name: phasenet, eqtransformer, etc.
ML_MODEL=phasenet
# Default annotator name for ML dataset exports
ML_ANNOTATOR=observatory_user

# ---------------------------------------------------------------------------
# Standalone Geophysical Observatory Web Server
# ---------------------------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8088

# ---------------------------------------------------------------------------
# USGS Regional Earthquake Enrichment & Distance Thresholds
# ---------------------------------------------------------------------------
USGS_ENABLED=true
USGS_POLL_INTERVAL_SEC=60.0
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_week.geojson
USGS_MIN_MAGNITUDE=0.5
DISTANCE_LOCAL_KM=80.0
DISTANCE_REGIONAL_KM=240.0
DISTANCE_STATE_KM=640.0

# ---------------------------------------------------------------------------
# External Events & Berkeley Local Context
# ---------------------------------------------------------------------------
EXTERNAL_EVENTS_ENABLED=true
EXTERNAL_EVENTS_SCHEDULE_POLL_SEC=3600.0
EXTERNAL_EVENTS_WEATHER_POLL_SEC=600.0
EXTERNAL_EVENTS_BART_POLL_SEC=60.0
CAL_FOOTBALL_TEAM_ID=25
GREEK_THEATRE_URL=https://thegreekberkeley.com/events/
BART_API_KEY=MW9S-E7SL-26DU-VV8V
BART_STATIONS=DBRK,ROCK
# Overhead Helicopter & Low-Altitude Aircraft ADS-B Monitor (airplanes.live)
EXTERNAL_EVENTS_AIRCRAFT_POLL_SEC=45.0
AIRCRAFT_RADIUS_NM=3.0
AIRCRAFT_MAX_ALT_FT=5000

# ---------------------------------------------------------------------------
# Multi-Station Witness, Rolling MiniSEED Archive & Auto Highlights
# ---------------------------------------------------------------------------
WITNESS_ENABLED=true
WITNESS_NETWORK=BK
WITNESS_STATION=BKS
WITNESS_CHANNEL=BHZ
WITNESS_FDSN_URL=https://service.ncedc.org/fdsnws/dataselect/1/query
WITNESS_LAT=37.8762
WITNESS_LON=-122.2356

ARCHIVE_ENABLED=true
ARCHIVE_DIR=./data/archive
ARCHIVE_RETENTION_HOURS=48

HIGHLIGHTS_ENABLED=true
HIGHLIGHTS_DIR=./data/highlights
HIGHLIGHTS_COOLDOWN_SEC=180.0

# ---------------------------------------------------------------------------
# Alerting & External Dashboard Webhook
# ---------------------------------------------------------------------------
DASHBOARD_ENABLED=false
# HTTP endpoint for external dashboard ingestion (when DASHBOARD_ENABLED=true)
DASHBOARD_URL=http://localhost:5050/api/ingest/earthquake-engine
# Minimum seconds between successive alerts (prevents flooding)
ALERT_COOLDOWN_SEC=30.0

# ---------------------------------------------------------------------------
# Telemetry & Health
# ---------------------------------------------------------------------------
# Interval for heartbeat/status messages (seconds)
HEARTBEAT_INTERVAL_SEC=60.0

# ---------------------------------------------------------------------------
# Data Buffer
# ---------------------------------------------------------------------------
# Rolling waveform buffer length in seconds
BUFFER_DURATION_SEC=120
# Sampling rate of the RS4D (Hz) — do not change unless hardware differs
SAMPLING_RATE=100

# ---------------------------------------------------------------------------
# Logging & Storage
# ---------------------------------------------------------------------------
# Minimum log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Directory for per-event JSONL logs
EVENT_LOG_DIR=./events
# Site noise model file (auto-updated by Quiet-Window Hunter)
NOISE_MODEL_PATH=./data/noise_model.json

# ---------------------------------------------------------------------------
# MQTT Message Bus (Home Intelligence Platform)
# ---------------------------------------------------------------------------
# Enable MQTT publishing (requires paho-mqtt: pip install paho-mqtt)
MQTT_ENABLED=false
# Mosquitto broker hostname/IP
MQTT_BROKER=localhost
# MQTT broker port (default 1883, TLS 8883)
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic schema — follows home/{type}/{agent} convention:
MQTT_TOPIC_ALERTS=home/alerts/earthquake
MQTT_TOPIC_STATUS=home/status/earthquake-engine
MQTT_TOPIC_EVENTS=home/events/earthquake
MQTT_TOPIC_COMMANDS=home/commands/display
MQTT_TOPIC_RSAM=home/sensors/rsam
